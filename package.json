{
  "name": "yorozu",
  "version": "0.3.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vitest watch",
    "test": "vitest run",
    "build": "packages/build-cli/bin/yorozu-build build :all",
    "lint:workspace": "packages/build-cli/bin/yorozu-build lint",
    "release": "packages/build-cli/bin/yorozu-build release --with-npm",
    "release:dry": "packages/build-cli/bin/yorozu-build release --with-npm --dry-run",
    "prepare": "pnpm run -C packages/build build-vite-plugin && pnpm run build:cli",
    "build:cli": "go build -C packages/build-cli -o bin/yorozu-build ./cmd/yorozu-build",
    "playground:animations": "vite --config packages/animations/playground/vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inshinrei/yorozu.git"
  },
  "author": "inshinrei",
  "license": "MIT",
  "devDependencies": {
    "@rolldown/binding-darwin-arm64": "1.0.0-rc.16",
    "@types/node": "25.6.0",
    "@yorozu/build": "workspace:^",
    "esbuild": "0.25.12",
    "prettier": "3.8.3",
    "ts-node": "10.9.2",
    "tsx": "4.23.12",
    "typescript": "6.0.2",
    "vite": "8.0.8",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.4"
  }
}
